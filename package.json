{
  "name": "@leadertechie/r2tohtml",
  "version": "0.0.0",
  "description": "Generic R2 content loader - fetch and cache content from Cloudflare R2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {
    "@leadertechie/telemetry": "^0.0.0"
  },
  "devDependencies": {
    "@leadertechie/md2html": "^0.1.0-alpha.22",
    "@types/node": "^20.0.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "@leadertechie/md2html": "^0.1.0-alpha.22"
  },
  "keywords": [
    "r2",
    "cloudflare",
    "content",
    "loader",
    "cache"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leadertechie/r2Tohtml.git"
  }
}
